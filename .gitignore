# --- Repo-root .gitignore (shared concerns) ---
# Per-app build artifacts are ignored by each app's own .gitignore:
#   apps/web/.gitignore   (Elixir/Phoenix: _build, deps, cover, plts, ...)
#   apps/cli/.gitignore   (Rust: target)

# If the VM crashes anywhere, it generates a dump.
erl_crash.dump

# VitePress docs site (Bun-managed at the repo root).
/node_modules/
/docs/.vitepress/cache/
/docs/.vitepress/dist/

# Local environment overrides.
.env
.envrc

# Per-project CLI config — holds a bearer token secret.
.alloy_env

# Epilogue Tracker per-project CLI config — holds a bearer token secret.
.et_env

# Claude Code local runtime artifacts.
.claude/scheduled_tasks.lock

# Finder (macOS) folder config.
.DS_Store
