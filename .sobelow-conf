# Sobelow configuration for Alloy.
#
# Run with: mix sobelow --config
#
# `exit: "low"` makes the security gate fail the build on any finding at
# or above low severity, so new issues cannot slip in silently.
#
# `ignore` skips two findings that are inherent to a fresh scaffold and
# belong to the deployment hardening phase, not application code:
#
#   * Config.CSP   — a Content-Security-Policy must be authored once the
#                    UI's asset/inline-script needs are known. Tracked as
#                    a hardening follow-up; see AGENTS.md.
#   * Config.HTTPS — TLS termination is handled by the reverse proxy in
#                    front of this app, by design; Alloy serves plain HTTP
#                    behind it and does not manage certs or HSTS itself.
#                    Settled decision, not a follow-up.
#
# Remove entries from `ignore` as each item is addressed.
[
  exit: "low",
  format: "txt",
  ignore: ["Config.CSP", "Config.HTTPS"],
  ignore_files: [],
  out: nil,
  private: false,
  router: nil,
  skip: false,
  threshold: :low,
  verbose: false,
  version: false
]
